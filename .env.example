# HTTP Basic Auth for the deployed site (Netlify edge function)
# Set this in the Netlify dashboard (Site settings -> Environment variables),
# NOT in a committed file. Format is username:password. If unset, the site
# denies all access (fail closed).
# BASIC_AUTH_CREDENTIALS=username:password

# ContentStorage Configuration
# Get your content key from the ContentStorage dashboard
# This is optional - if not provided, the key from contentstorage.config.js will be used
# VITE_CONTENTSTORAGE_KEY=your-project-id/your-key-here

# Example:
# VITE_CONTENTSTORAGE_KEY=108541025900791613826/ee363022-755c-4b18-a14b-9a947ef88db7